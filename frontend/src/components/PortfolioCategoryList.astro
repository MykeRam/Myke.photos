---
import type { PortfolioCategory } from '../data/site';

interface Props {
  categories: PortfolioCategory[];
}

const { categories } = Astro.props;
---

<nav class="category-list" aria-label="Explore photography by category">
  {categories.map((category) => (
    <a class="category-link" href={category.slug === 'just-for-fun' ? '/portfolio/analog/' : '/portfolio/selected/'}>
      <span class="category-link__title">{category.title}</span>
      <span class="category-link__description">{category.description}</span>
      <span class="category-link__arrow" aria-hidden="true">
        ↗
      </span>
    </a>
  ))}
</nav>
