---
import Eyebrow from './Eyebrow.astro';

interface Props {
  eyebrow?: string;
  title: string;
  headingId?: string;
}

const { eyebrow, title, headingId } = Astro.props;
---

<div class:list={['section-intro', { 'section-intro--solo': !eyebrow }]}>
  {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
  <h2 id={headingId}>{title}</h2>
</div>
