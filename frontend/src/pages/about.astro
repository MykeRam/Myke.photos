---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArrowLink from '../components/ArrowLink.astro';
import PageIntro from '../components/PageIntro.astro';
---
<BaseLayout title="About — Myke.photos" description="About Myke and his photographic practice.">
  <article class="editorial-page">
    <PageIntro eyebrow="About / Myke" title="Looking closely at the world as it changes." />
    <div class="editorial-grid section-rule">
      <p class="editorial-lead">Myke is a New York–based photographer drawn to atmosphere, overlooked gestures, and the character of a place.</p>
      <div class="editorial-body">
        <p>The work moves between street observation, portraiture, and visual studies. Whether working independently or on assignment, the approach is patient, direct, and attentive to what is already present.</p>
        <p>Myke is available for selected editorial, portrait, and commissioned projects in New York and beyond.</p>
        <ArrowLink href="/contact/">Start a conversation</ArrowLink>
      </div>
    </div>
  </article>
</BaseLayout>
