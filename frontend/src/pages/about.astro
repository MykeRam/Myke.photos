---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArrowLink from '../components/ArrowLink.astro';
import Eyebrow from '../components/Eyebrow.astro';
---

<BaseLayout title="About — Myke.photos" description="About Myke and his photographic practice.">
  <article class="editorial-page">
    <header class="about-intro">
      <span id="about-intro" class="about-anchor"><Eyebrow>About / Myke</Eyebrow></span>
      <figure class="about-portrait">
        <img src="/images/about-portrait-placeholder.jpg" alt="Portrait of Myke" width="1122" height="1402" />
      </figure>
    </header>
    <div class="editorial-grid section-rule">
      <p class="editorial-lead">Myke is a New York–based photographer.</p>
      <div class="editorial-body">
        <p>
          The work moves between street observation, portraiture, and visual studies. Whether
          working independently or on assignment, the approach is patient, direct, and attentive to
          what is already present.
        </p>
        <p>
          Myke is available for selected editorial, portrait, and commissioned projects in New York
          and beyond.
        </p>
        <ArrowLink href="/contact/">Start a conversation</ArrowLink>
      </div>
    </div>
  </article>
</BaseLayout>
