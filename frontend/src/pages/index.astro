---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhotoCard from '../components/PhotoCard.astro';
import { featuredPhotos } from '../data/site';
---
<BaseLayout>
  <section class="hero" aria-labelledby="hero-title">
    <figure class="hero-media">
      <img src={featuredPhotos[0].image} alt={featuredPhotos[0].alt} width="1200" height="1500" fetchpriority="high" />
      <figcaption>{featuredPhotos[0].location} · 2026</figcaption>
    </figure>
    <div class="hero-copy">
      <p class="eyebrow">Photography by Myke</p>
      <h1 id="hero-title">Images for the spaces between things.</h1>
      <a class="arrow-link" href="/portfolio/">View selected work <span aria-hidden="true">↘</span></a>
    </div>
  </section>

  <section class="selected-work section-rule" aria-labelledby="selected-title">
    <div class="section-intro">
      <p class="eyebrow">01 / Selected work</p>
      <h2 id="selected-title">A moving archive.</h2>
    </div>
    <div class="photo-grid">
      {featuredPhotos.slice(1).map((photo, index) => <PhotoCard photo={photo} eager={index === 0} />)}
    </div>
    <div class="section-action"><a class="arrow-link" href="/portfolio/">Explore the portfolio <span aria-hidden="true">→</span></a></div>
  </section>

  <section class="statement section-rule" aria-labelledby="statement-title">
    <p class="eyebrow">02 / Practice</p>
    <h2 id="statement-title">Photographs about atmosphere, place, and the details that stay with us.</h2>
    <a class="arrow-link" href="/about/">About Myke <span aria-hidden="true">→</span></a>
  </section>
</BaseLayout>
