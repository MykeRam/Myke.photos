---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArrowLink from '../components/ArrowLink.astro';
import Eyebrow from '../components/Eyebrow.astro';
import PhotoCard from '../components/PhotoCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { featuredPhotos } from '../data/site';
---
<BaseLayout immersive>
  <section class="hero" aria-labelledby="hero-title">
    <figure class="hero-media">
      <img src={featuredPhotos[0].image} alt={featuredPhotos[0].alt} width="1200" height="1500" fetchpriority="high" />
      <figcaption>{featuredPhotos[0].location} · 2026</figcaption>
    </figure>
    <div class="hero-copy">
      <Eyebrow>Photography by Myke</Eyebrow>
      <h1 id="hero-title">Images for the spaces between things.</h1>
      <ArrowLink href="/portfolio/" direction="down">View selected work</ArrowLink>
    </div>
  </section>

  <section class="selected-work section-rule" aria-labelledby="selected-title">
    <SectionHeading eyebrow="01 / Selected work" title="A moving archive." headingId="selected-title" />
    <div class="photo-grid">
      {featuredPhotos.slice(1).map((photo, index) => <PhotoCard photo={photo} eager={index === 0} />)}
    </div>
    <div class="section-action"><ArrowLink href="/portfolio/">Explore the portfolio</ArrowLink></div>
  </section>

  <section class="statement section-rule" aria-labelledby="statement-title">
    <Eyebrow>02 / Practice</Eyebrow>
    <h2 id="statement-title">Photographs about atmosphere, place, and the details that stay with us.</h2>
    <ArrowLink href="/about/">About Myke</ArrowLink>
  </section>
</BaseLayout>
