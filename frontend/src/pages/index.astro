---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArrowLink from '../components/ArrowLink.astro';
import Eyebrow from '../components/Eyebrow.astro';
import PortfolioCategoryList from '../components/PortfolioCategoryList.astro';
import { featuredPhotos, portfolioCategories } from '../data/site';
---
<BaseLayout immersive>
  <section class="hero" aria-labelledby="hero-title">
    <figure class="hero-media">
      <img src={featuredPhotos[0].image} alt={featuredPhotos[0].alt} width="1200" height="1500" fetchpriority="high" />
      <figcaption>{featuredPhotos[0].location} · 2026</figcaption>
    </figure>
    <div class="hero-copy">
      <Eyebrow>Photography by Myke</Eyebrow>
      <h1 id="hero-title">Lorem ipsum.</h1>
      <ArrowLink href="/portfolio/" direction="down">View selected work</ArrowLink>
    </div>
  </section>

  <section class="work-index section-rule" aria-labelledby="work-index-title">
    <h2 id="work-index-title">Explore the work.</h2>
    <PortfolioCategoryList categories={portfolioCategories} />
  </section>

  <section class="statement section-rule" aria-labelledby="statement-title">
    <h2 id="statement-title">Photographs about atmosphere, place, and the details that stay with us.</h2>
    <ArrowLink href="/about/">About Myke</ArrowLink>
  </section>
</BaseLayout>
