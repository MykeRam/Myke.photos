---
import BaseLayout from '../layouts/BaseLayout.astro';
import { featuredPhotos } from '../data/site';
---
<BaseLayout>
  <main>
    <header class="site-header">
      <a class="wordmark" href="/">myke<span>.photos</span></a>
      <nav aria-label="Primary navigation">
        <a href="#work">Work</a>
        <a href="#about">About</a>
        <a href="#contact">Contact</a>
      </nav>
    </header>

    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-image" role="img" aria-label={featuredPhotos[0].alt}></div>
      <div class="hero-copy">
        <p class="eyebrow">Photography by Myke</p>
        <h1 id="hero-title">Images for the spaces between things.</h1>
        <a class="text-link" href="#work">View selected work <span>↘</span></a>
      </div>
    </section>

    <section id="work" class="work-section" aria-labelledby="work-title">
      <div class="section-heading"><p class="eyebrow">01 / Selected work</p><h2 id="work-title">A moving archive.</h2></div>
      <div class="photo-grid">
        {featuredPhotos.slice(1).map((photo) => (
          <figure><div class="photo-frame" style={`background-image: url(${photo.image})`}></div><figcaption><span>{photo.title}</span><span>{photo.location}</span></figcaption></figure>
        ))}
      </div>
    </section>

    <section id="about" class="about-section"><p class="eyebrow">02 / About</p><p class="about-copy">I make photographs about atmosphere, place, and the small details that stay with us. Available for selected editorial, portrait, and commissioned work.</p></section>

    <footer id="contact" class="site-footer"><div><p class="eyebrow">03 / Contact</p><a class="email" href="mailto:hello@myke.photos">hello@myke.photos</a></div><p>New York · Available worldwide<br />© {new Date().getFullYear()} Myke.photos</p></footer>
  </main>
</BaseLayout>

<style>
  @import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400&family=Manrope:wght@400;500;600&display=swap');
  :global(*) { box-sizing: border-box; }
  :global(body) { margin: 0; background: #e9e6df; color: #171714; font-family: Manrope, sans-serif; }
  :global(a) { color: inherit; text-decoration: none; }
  main { max-width: 1440px; margin: auto; padding: 0 4vw; }
  .site-header { display: flex; justify-content: space-between; align-items: center; padding: 28px 0; font-size: .82rem; }
  .wordmark { font-size: 1.05rem; font-weight: 600; letter-spacing: -.04em; }.wordmark span { color: #6d6b63; }
  nav { display: flex; gap: 28px; } nav a, .eyebrow { font-family: 'DM Mono', monospace; font-size: .67rem; text-transform: uppercase; letter-spacing: .08em; }
  .hero { min-height: 77vh; display: grid; grid-template-columns: 1.65fr 1fr; gap: 4vw; align-items: end; padding: 7vh 0 12vh; }.hero-image { min-height: 66vh; background: url('/images/hero.svg') center/cover; }.hero-copy { padding-bottom: 1vh; max-width: 390px; }.eyebrow { color: #6d6b63; margin: 0 0 22px; }.hero h1 { font-size: clamp(2.6rem, 5vw, 5.8rem); line-height: .96; letter-spacing: -.075em; font-weight: 500; margin: 0 0 42px; }.text-link { border-bottom: 1px solid #171714; padding-bottom: 8px; font-size: .85rem; }.text-link span { margin-left: 35px; }
  .work-section { padding: 10vh 0; border-top: 1px solid #c9c6be; }.section-heading { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 50px; }.section-heading h2 { font-size: clamp(1.8rem, 3vw, 3.2rem); font-weight: 500; letter-spacing: -.06em; margin: 0; }.photo-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4vw; }.photo-frame { aspect-ratio: 4 / 5; background-size: cover; background-position: center; }figure { margin: 0; }figcaption { display: flex; justify-content: space-between; padding-top: 12px; font-size: .76rem; color: #6d6b63; }
  .about-section { padding: 13vh 10vw 18vh; border-top: 1px solid #c9c6be; }.about-copy { max-width: 760px; font-size: clamp(1.8rem, 3.5vw, 4rem); line-height: 1.08; letter-spacing: -.06em; margin: 0; }
  .site-footer { display: flex; justify-content: space-between; padding: 28px 0 40px; border-top: 1px solid #c9c6be; font-size: .76rem; color: #6d6b63; }.email { color: #171714; font-size: 1.15rem; }.site-footer p:last-child { text-align: right; line-height: 1.6; margin: 0; }
  @media (max-width: 700px) { main { padding: 0 20px; }.hero { display: block; padding: 5vh 0 12vh; }.hero-image { min-height: 58vh; margin-bottom: 38px; }.hero h1 { font-size: 3.2rem; }.section-heading { display: block; }.section-heading h2 { margin-top: 35px; }.photo-grid { gap: 20px; }.about-section { padding: 10vh 0 14vh; }.site-footer { display: block; }.site-footer p:last-child { text-align: left; margin-top: 50px; } }
</style>
